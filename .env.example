RIB_DATABASE_URL=postgresql://ripple:ripple@localhost:5432/rib
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
RIB_WORKSPACE_ROOT=/tmp/ripple-workspaces
RIB_LOG_LEVEL=INFO
ANTHROPIC_API_KEY=

# Optional SCIP indexers (used when committed index.scip is missing or stale)
# Java: scip-java or coursier (cs)
# Python: scip-python or python -m scip_python
# TypeScript: scip-typescript or npx @sourcegraph/scip-typescript
# Read index.scip: scip CLI — run scripts/install-scip-cli.sh
